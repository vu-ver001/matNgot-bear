APP_NAME="Mật Ngọt Bear"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Ho_Chi_Minh"
# IP Wi-Fi của máy chủ hay đổi (ví dụ hiện tại 172.20.10.3). Lấy IP mới bằng `ipconfig`,
# rồi sửa APP_URL cho khớp và giữ APP_PORT đồng bộ với cổng mở firewall.
APP_URL=http://192.168.1.10:8080
APP_PORT=8080

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=matngotbear
DB_USERNAME=matngotbear
DB_PASSWORD=replace-with-a-long-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Để trống để cookie dùng đúng IP/host hiện tại. Không ghi chữ "null".
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Copy only the integration values needed by this deployment from your
# existing .env. Do not commit real credentials to this example file.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_ORIGIN_DISTRICT_ID=1482
GHN_ORIGIN_WARD_CODE="11007"
GHN_API_URL="https://online-gateway.ghn.vn/shiip/public-api"

SHOP_ORIGIN_ADDRESS="Số 41A, Phú Diễn, Bắc Từ Liêm, Hà Nội"
SHOP_ORIGIN_LAT=21.0456
SHOP_ORIGIN_LNG=105.7628

VIETQR_BANK_CODE=MB
VIETQR_BANK_NAME="MB Bank (Ngân hàng Quân Đội)"
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL="${APP_URL}/payment/momo/return"
MOMO_IPN_URL="${APP_URL}/payment/momo/ipn"
MOMO_PHONE=
MOMO_NAME=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/payment/vnpay/return"
VNPAY_IPN_URL="${APP_URL}/payment/vnpay/ipn"
VNPAY_MERCHANT_NAME="MẬT NGỌT BEAR"

SEPAY_API_KEY=
# Chấp nhận cả 2 tên; chỉ cần đặt một trong hai với cùng giá trị.
SEPAY_WEBHOOK_TOKEN=
SEPAY_WEBHOOK_SECRET=
